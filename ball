BackwardBtn.Parent = ControlFrame

-- ==================== Логика ====================
local function updateBall(delta)
    ball.CanCollide = true
    humanoid.PlatformStand = true

    if UserInputService:GetFocusedTextBox() then return end

    -- Старое управление WASD (ПК)
    if UserInputService:IsKeyDown("W") or forwardButtonDown then
        ball.RotVelocity -= Camera.CFrame.RightVector * delta * SPEED_MULTIPLIER
    end
    if UserInputService:IsKeyDown("A") then
        ball.RotVelocity -= Camera.CFrame.LookVector * delta * SPEED_MULTIPLIER
    end
    if UserInputService:IsKeyDown("S") or backwardButtonDown then
        ball.RotVelocity += Camera.CFrame.RightVector * delta * SPEED_MULTIPLIER
    end
    if UserInputService:IsKeyDown("D") then
        ball.RotVelocity += Camera.CFrame.LookVector * delta * SPEED_MULTIPLIER
    end
end

local function enableBallMode()
    isBallMode = true
    ToggleBtn.Text = "Выключить режим мяча"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)

    for _, v in ipairs(character:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end

    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(5,5,5)

    humanoid.PlatformStand = true
    Camera.CameraSubject = ball

    ControlFrame.Visible = true
    connection = RunService.RenderStepped:Connect(updateBall)
end

local function disableBallMode()
    isBallMode = false
    ToggleBtn.Text = "Включить режим мяча"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    ControlFrame.Visible = false

    if connection then
        connection:Disconnect()
        connection = nil
    end

    humanoid.PlatformStand = false
    Camera.CameraSubject = humanoid
end

-- Кнопки главного меню
ToggleBtn.MouseButton1Click:Connect(function()
    if isBallMode then disableBallMode() else enableBallMode() end
end)

CloseBtn.MouseButton1Click:Connect(function()
    disableBallMode()
    ScreenGui:Destroy()
end)

-- Обработка нажатий на контрольные кнопки
local function handleInput(btn, isDown)
    if btn.Name == "Forward" then
        forwardButtonDown = isDown
    elseif btn.Name == "Backward" then
        backwardButtonDown = isDown
    end
end

ForwardBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        handleInput(ForwardBtn, true)
    end
end)
ForwardBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        handleInput(ForwardBtn, false)
    end
end)

BackwardBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        handleInput(BackwardBtn, true)
    end
end)
BackwardBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        handleInput(BackwardBtn, false)
    end
end)

-- Прыжок
UserInputService.JumpRequest:Connect(function()
    if not isBallMode then return end
    local result = workspace:Raycast(ball.Position, Vector3.new(0, -((ball.Size.Y/2)+JUMP_GAP), 0), params)
    if result then
        ball.Velocity = ball.Velocity + Vector3.new(0, JUMP_POWER, 0)
    end
end)

player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    ball = newChar:WaitForChild("HumanoidRootPart")
end)

humanoid.Died:Connect(disableBallMode)
