-- ===== ЛОГИКА =====

local function serializeWaypoints()
    local parts = {}
    for _, wp in ipairs(waypoints) do
        table.insert(parts, string.format("%.2f,%.2f,%.2f,%.2f", wp.pos.X, wp.pos.Y, wp.pos.Z, wp.delay))
    end
    return table.concat(parts, ";")
end

local function deserializeWaypoints(str)
    local result = {}
    for entry in str:gmatch("[^;]+") do
        local x, y, z, d = entry:match("(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+),(%-?[%d%.]+)")
        if x and y and z and d then
            table.insert(result, {
                pos = Vector3.new(tonumber(x), tonumber(y), tonumber(z)),
                delay = tonumber(d)
            })
        end
    end
    return result
end

