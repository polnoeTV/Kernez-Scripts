    end
    local data = serializeWaypoints()
    ImportBox.Text = data
    -- Попытка скопировать в буфер (работает в некоторых исполнителях)
    if setclipboard then
        setclipboard(data)
        StatusLabel.Text = "Скопировано в буфер (" .. #waypoints .. " точек)"
    else
        StatusLabel.Text = "Скопируй текст из поля ввода вручную"
    end
    ClipLabel.Text = data
end)

-- Импорт
local function doImport()
    local text = ImportBox.Text
    if text == "" then
        StatusLabel.Text = "Поле пустое — вставь данные точек"
        return
    end
    local loaded = deserializeWaypoints(text)
    if #loaded > 0 then
        waypoints = loaded
        updateList()
        StatusLabel.Text = "Загружено точек: " .. #loaded
        ImportBox.Text = ""
    else
        StatusLabel.Text = "Ошибка: неверный формат данных"
    end
end

ImportBtn.MouseButton1Click:Connect(doImport)
ImportBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then doImport() end
end)

-- Старт / стоп
StartButton.MouseButton1Click:Connect(function()
    farming = not farming
    if farming then
        if #waypoints == 0 then
            farming = false
            StatusLabel.Text = "Нет точек для фарма"
            return
        end
        StartButton.Text = "⏹  Остановить фарм"
        StartButton.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        StatusLabel.Text = "Фарм запущен..."

        spawn(function()
            while farming and #waypoints > 0 do
                local wp = waypoints[currentIndex]
                if wp then
                    root.CFrame = CFrame.new(wp.pos + Vector3.new(0, 3, 0))
                    StatusLabel.Text = string.format("Точка %d/%d | ожидание %.1fс", currentIndex, #waypoints, wp.delay)
                    local t = 0
                    local step = 0.1
                    while farming and t < wp.delay do
                        wait(step)
                        t = t + step
                    end
                    if not farming then break end
                    currentIndex = currentIndex + 1
                    if currentIndex > #waypoints then
                        currentIndex = 1
                    end
                else
                    wait(0.5)
                end
            end
            if not farming then
                StatusLabel.Text = "Фарм остановлен"
            end
        end)
    else
        StartButton.Text = "▶  Запустить фарм"
        StartButton.BackgroundColor3 = Color3.fromRGB(0, 160, 80)
        StatusLabel.Text = "Фарм остановлен"
    end
end)

